<Application x:Class="IkuyoPet.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Startup="OnStartup" ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LogFilterStyles.xaml"/>
                <ResourceDictionary Source="Themes/FormStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/></Style>
            <Style TargetType="UserControl"><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/></Style>
            <Style x:Key="NavButton" TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource TitleFont}"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
