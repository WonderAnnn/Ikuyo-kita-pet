<UserControl x:Class="IkuyoPet.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#FF263247" Text="今日时间线"/>
        <TextBlock Margin="0,8,0,16" Foreground="#FF68778D" Text="按提醒时间记录渠道、动作和结果；不记录睡眠或医疗信息。" TextWrapping="Wrap"/>
        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
            <DatePicker Width="130" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"/>
            <ComboBox Margin="18,0,8,0" Width="96" SelectedValue="{Binding KindFilter, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="全部"/><ComboBoxItem Content="喝水"/><ComboBoxItem Content="活动"/><ComboBoxItem Content="工作"/></ComboBox>
            <ComboBox Width="96" SelectedValue="{Binding OutcomeFilter, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="全部结果"/><ComboBoxItem Content="完成"/><ComboBoxItem Content="搁置"/><ComboBoxItem Content="跳过"/></ComboBox>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding TimelineItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="14" CornerRadius="12" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock FontSize="11" Foreground="#FF9AA6B8" Text="{Binding ScheduledAt, StringFormat=yyyy-MM-dd}"/><TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Foreground="#FF263247" Text="{Binding ScheduledAt, StringFormat=HH:mm}"/></StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="#FF263247" Text="{Binding KindText}"/>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Foreground="#FF68778D" Text="{Binding ChannelText}"/>
                                    <TextBlock Foreground="#FF68778D" Text=" · "/>
                                    <TextBlock Foreground="#FF68778D" Text="{Binding OutcomeText}"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Foreground="#FF9AA6B8" Text="{Binding ActionAt, StringFormat=动作：{0:HH:mm}}"/>
                                    <TextBlock Margin="10,0,0,0" Foreground="#FF9AA6B8" Text="{Binding RetryIndex, StringFormat=重试 {0} 次}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,20,0,0" Foreground="#FF68778D" Text="今天还没有小记，等下一次提醒再一起记录吧">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding TimelineItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
