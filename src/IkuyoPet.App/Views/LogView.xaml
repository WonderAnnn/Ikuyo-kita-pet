<UserControl x:Class="IkuyoPet.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#FF263247" Text="提醒与活动日志"/>
            <TextBlock Margin="0,8,0,16" Foreground="#FF68778D" Text="动作完成后会立即刷新；只记录日期、时间、渠道和结果，不记录睡眠或医疗信息。" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource LogFilterBarStyle}"><WrapPanel Orientation="Horizontal">
            <DatePicker Style="{StaticResource LogDatePickerStyle}" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" AutomationProperties.Name="日期筛选" Margin="0,0,12,0"/>
            <ComboBox Style="{StaticResource LogComboBoxStyle}" Width="116" SelectedValue="{Binding KindFilter, Mode=TwoWay}" SelectedValuePath="Content" AutomationProperties.Name="类型筛选" Margin="0,0,12,0"><ComboBoxItem Content="全部"/><ComboBoxItem Content="喝水"/><ComboBoxItem Content="活动"/><ComboBoxItem Content="工作"/></ComboBox>
            <ComboBox Style="{StaticResource LogComboBoxStyle}" Width="132" SelectedValue="{Binding OutcomeFilter, Mode=TwoWay}" SelectedValuePath="Content" AutomationProperties.Name="结果筛选"><ComboBoxItem Content="全部结果"/><ComboBoxItem Content="完成"/><ComboBoxItem Content="搁置"/><ComboBoxItem Content="跳过"/><ComboBoxItem Content="未响应"/><ComboBoxItem Content="待处理"/></ComboBox>
        </WrapPanel></Border>
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TimelineItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="14" CornerRadius="12" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock FontSize="11" Foreground="#FF9AA6B8" Text="{Binding ScheduledAt, StringFormat=yyyy-MM-dd}"/><TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Foreground="#FF263247" Text="{Binding ScheduledAt, StringFormat=HH:mm}"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Foreground="#FF263247" Text="{Binding KindText}"/><TextBlock Margin="0,4,0,0" Foreground="#FF68778D" Text="{Binding ChannelText}"/></StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock FontWeight="SemiBold" Foreground="#FF9B5473" Text="{Binding OutcomeText}"/><TextBlock Margin="0,4,0,0" Foreground="#FF9AA6B8" Text="{Binding ActionAt, StringFormat={}{0:HH:mm}}"/><TextBlock Foreground="#FF9AA6B8" Text="{Binding RetryIndex, StringFormat=重提 {0} 次}"/></StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF68778D" Text="这一天还没有日志">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TimelineItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
