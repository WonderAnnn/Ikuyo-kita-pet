<UserControl x:Class="IkuyoPet.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource FormPageTitle}" Text="今天也按自己的节奏来"/>
            <Border Margin="0,20,0,16" Padding="22" CornerRadius="22" Background="#FFEAF4FF">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="16" Foreground="#FF68778D" Text="下一次离屏活动"/>
                        <TextBlock Margin="0,10,0,0" FontSize="22" FontWeight="SemiBold" Foreground="#FF263247" Text="{Binding NextActivityText}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,10,0,0" Foreground="#FF68778D" Text="{Binding RuleSummaryText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Margin="20,0,0,0" Padding="16,9" VerticalAlignment="Top" CornerRadius="18" Background="#FFFFD9E8">
                        <TextBlock Foreground="#FF9B5473" FontWeight="SemiBold" Text="{Binding ReminderChannelText}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Margin="0,0,0,16" Padding="16,11" CornerRadius="14"
                    Background="White" BorderBrush="#FFDDEAF6" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#FF68778D" Text="下一次喝水"/>
                    <TextBlock Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#FF4D7896"
                               Text="{Binding NextHydrationText}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,0,16" Padding="16" CornerRadius="14" Background="#FFFFF7FB" BorderBrush="#FFF6D8E7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#FF9B5473" FontWeight="SemiBold" Text="现在就完成一次"/>
                    <TextBlock Margin="0,5,0,12" Foreground="#FF68778D" Text="手动记录后会重新安排下一次随机提醒，并让喜多马上为你加油。" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="我要喝水" Command="{Binding ManualWaterCommand}" Style="{StaticResource PrimaryButton}" Width="96" Height="36" FontSize="13" Padding="0" Margin="0,0,10,0"/>
                        <Button Content="我要休息" Command="{Binding ManualActivityCommand}" Style="{StaticResource GhostButton}" Width="96" Height="36" FontSize="13" Padding="0" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <UniformGrid Columns="3">
                <Border Margin="0,0,8,0" Padding="16" CornerRadius="14" Background="White"><StackPanel><TextBlock Text="喝水完成" Foreground="#FF68778D"/><TextBlock Margin="0,6,0,0" Text="{Binding HydrationText}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Margin="4,0" Padding="16" CornerRadius="14" Background="White"><StackPanel><TextBlock Text="活动完成" Foreground="#FF68778D"/><TextBlock Margin="0,6,0,0" Text="{Binding ActivityText}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Margin="8,0,0,0" Padding="16" CornerRadius="14" Background="White"><StackPanel><TextBlock Text="累计有效工作" Foreground="#FF68778D"/><TextBlock Margin="0,6,0,0" Text="{Binding TotalWorkDurationText}" FontSize="24" FontWeight="SemiBold"/><TextBlock Margin="0,4,0,0" Text="今天有效工作" Foreground="#FF68778D" FontSize="13"/><TextBlock Margin="0,1,0,0" Text="{Binding TodayWorkDurationText}" Foreground="#FF68778D" FontSize="13"/></StackPanel></Border>
            </UniformGrid>
            <Border Margin="0,16,0,0" Padding="16" CornerRadius="14" BorderBrush="#FFE2E8F0" BorderThickness="1" Background="#FFFAFCFF">
                <TextBlock Foreground="#FF68778D" Text="这里只记录提醒时间、接受/搁置/跳过/未响应和白名单应用的有效前台工作时长；不记录睡眠、医疗报告或窗口内容。" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
