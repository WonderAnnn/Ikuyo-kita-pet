<UserControl x:Class="IkuyoPet.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#FF263247" Text="设置"/>
            <Border Margin="0,20,0,0" Padding="18" CornerRadius="16" Background="White">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="提醒呈现"/>
                    <CheckBox Margin="0,14,0,0" Content="启用透明可拖动桌宠；关闭后仅使用 Windows 通知" IsChecked="{Binding PetEnabled, Mode=TwoWay}"/>
                    <CheckBox Margin="0,14,0,0" Content="登录 Windows 时启动 Ikuyo Pet（仅当前用户）" IsChecked="{Binding StartupEnabled, Mode=TwoWay}"/>
                    <TextBlock Margin="0,10,0,0" Foreground="#FF68778D" Text="{Binding StartupStatus}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Padding="18" CornerRadius="16" Background="White">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="桌宠与当前皮肤"/>
                    <TextBlock Margin="0,10,0,0" Foreground="#FF263247" Text="{Binding CurrentSkinText}"/>
                    <TextBlock Margin="0,6,0,0" Foreground="#FF68778D" Text="皮肤包使用透明 PNG，并按原始比例缩放；加载失败时自动回退占位图，不会停止提醒。" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Padding="18" CornerRadius="16" Background="White">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="当前活动规则"/>
                    <TextBlock Margin="0,10,0,0" Foreground="#FF68778D" Text="{Binding RuleSummaryText}" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,6,0,0" Foreground="#FF9AA6B8" Text="医生后续建议可以调整规则数值；软件默认值不是诊断或治疗建议。" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Padding="18" CornerRadius="16" Background="White">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="有效工作统计白名单"/>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBox Width="150" Margin="0,0,8,0" Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" ToolTip="进程名，例如 pycharm64"/>
                        <TextBox Width="150" Margin="0,0,8,0" Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" ToolTip="显示名，例如 PyCharm"/>
                        <Button Content="添加" Command="{Binding AddTrackedApplicationCommand}" Padding="12,4"/>
                    </StackPanel>
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding TrackedApplications}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Margin="0,2" Foreground="#FF68778D" Text="{Binding DisplayName}"/><TextBlock Margin="0,2" Foreground="#FF9AA8B8" Text="  ("/><TextBlock Margin="0,2" Foreground="#FF9AA8B8" Text="{Binding ProcessName}"/><TextBlock Margin="0,2" Foreground="#FF9AA8B8" Text=")"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Margin="0,10,0,0" Foreground="#FF68778D" Text="仅当前台命中白名单、电脑未锁屏且近 5 分钟有人机操作时累计；后台、离开电脑和睡眠时间均不计入。" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Margin="0,12,0,4" Foreground="#FF68778D" Text="{Binding SettingsStatus}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,4,0,12" Foreground="#FF9AA6B8" Text="{Binding VersionText}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>