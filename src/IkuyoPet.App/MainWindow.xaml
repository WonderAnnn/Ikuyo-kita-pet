<Window x:Class="IkuyoPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IkuyoPet.App.Views"
        xmlns:pet="clr-namespace:IkuyoPet.Pet;assembly=IkuyoPet.Pet"
        Title="Ikuyo Pet"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="BubbleThemeCardButton" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#FFF7FBFF"/>
            <Setter Property="BorderBrush" Value="#FFDCEAF6"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15" Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFF7FB"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFB9D3"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFF4F9"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFF8FBD"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2.5"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#FFF4F8FD">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFEAF4FF" Padding="18">
            <StackPanel>
                <TextBlock FontFamily="{StaticResource TitleFont}" FontSize="26" FontWeight="Bold" Foreground="#FF263247" Text="Ikuyo Pet" Margin="0,8,0,26"/>
                <Button Tag="Today" Click="NavigateClick" Content="今日" Style="{StaticResource NavButton}"/>
                <Button Tag="Log" Click="NavigateClick" Content="日志" Style="{StaticResource NavButton}"/>
                <Button Tag="Rules" Click="NavigateClick" Content="提醒规则" Style="{StaticResource NavButton}"/>
                <Button Tag="Diagnostics" Click="NavigateClick" Content="状态诊断" Style="{StaticResource NavButton}"/>
                <Button Tag="Pet" Click="NavigateClick" Content="桌宠与皮肤" Style="{StaticResource NavButton}"/>
                <Button Tag="Settings" Click="NavigateClick" Content="设置" Style="{StaticResource NavButton}"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="0">
            <views:TodayView x:Name="TodayPanel" Margin="28"/>
            <views:LogView x:Name="LogPanel" Margin="28" Visibility="Collapsed"/>
            <Grid x:Name="RulesPanel" Margin="30,26,30,20" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FormPageTitle}" Text="提醒规则"/>
                        <TextBlock Margin="0,8,0,20" Style="{StaticResource FormHint}"
                                   Text="医生给出新建议后，直接修改这里的数值保存即可，不需要改代码；默认值仅供一般参考，不是医疗建议。"/>

                        <!--  喝水提醒  -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Style="{StaticResource FormAccentBar}"/>
                                    <TextBlock Grid.Column="1" Margin="11,0,0,0" Style="{StaticResource FormSectionTitle}" Text="喝水提醒"/>
                                    <Border Grid.Column="2" Style="{StaticResource FormTagPill}" HorizontalAlignment="Left">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF9B5473" Text="按自然时间间隔"/>
                                    </Border>
                                </Grid>
                                <CheckBox Margin="0,16,0,0" Style="{StaticResource FormCheckBox}" Content="启用喝水提醒" IsChecked="{Binding WaterRule.Enabled, Mode=TwoWay}"/>
                                <TextBlock Margin="0,18,0,0" Style="{StaticResource FormLabel}" Text="提醒文案"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding WaterRule.Message, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="1.3*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="生效开始"/>
                                        <TextBox Style="{StaticResource FormTextBox}" ToolTip="本地时间 HH:mm" Text="{Binding WaterRule.StartLocal}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="生效结束"/>
                                        <TextBox Style="{StaticResource FormTextBox}" ToolTip="本地时间 HH:mm" Text="{Binding WaterRule.EndLocal}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="间隔范围（分钟）"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource FormTextBox}" ToolTip="最小间隔分钟数" Text="{Binding WaterRule.IntervalMinMinutes}"
                                                     PreviewTextInput="NumericTextBoxPreviewTextInput" DataObject.Pasting="NumericTextBoxPasting"/>
                                            <TextBlock Grid.Column="1" Text="–" FontSize="16" Foreground="#FF9B5473" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource FormTextBox}" ToolTip="最大间隔分钟数" Text="{Binding WaterRule.IntervalMaxMinutes}"
                                                     PreviewTextInput="NumericTextBoxPreviewTextInput" DataObject.Pasting="NumericTextBoxPasting"/>
                                        </Grid>
                                        <TextBlock Margin="1,5,0,0" Style="{StaticResource FormHint}" FontSize="11"
                                                   Text="范围 1–1440 分钟（不超过24小时）"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,20,0,0" Style="{StaticResource FormCheckBox}" Content="启用免打扰时段（期间不提醒）" IsChecked="{Binding WaterRule.QuietEnabled, Mode=TwoWay}"/>
                                <Border Style="{StaticResource FormSubPanel}" IsEnabled="{Binding WaterRule.QuietEnabled}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="免打扰开始"/>
                                            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding WaterRule.QuietStartLocal}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="免打扰结束"/>
                                            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding WaterRule.QuietEndLocal}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!--  离屏活动提醒  -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Style="{StaticResource FormAccentBar}"/>
                                    <TextBlock Grid.Column="1" Margin="11,0,0,0" Style="{StaticResource FormSectionTitle}" Text="离屏活动提醒"/>
                                    <Border Grid.Column="2" Style="{StaticResource FormTagPill}" HorizontalAlignment="Left">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF9B5473" Text="按有效工作时间"/>
                                    </Border>
                                </Grid>
                                <CheckBox Margin="0,16,0,0" Style="{StaticResource FormCheckBox}" Content="启用活动提醒" IsChecked="{Binding ActivityRule.Enabled, Mode=TwoWay}"/>
                                <TextBlock Margin="0,18,0,0" Style="{StaticResource FormLabel}" Text="提醒文案"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ActivityRule.Message, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="生效开始"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ActivityRule.StartLocal}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="生效结束"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ActivityRule.EndLocal}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="间隔范围（分钟）"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource FormTextBox}" Text="{Binding ActivityRule.IntervalMinMinutes}"
                                                     PreviewTextInput="NumericTextBoxPreviewTextInput" DataObject.Pasting="NumericTextBoxPasting"/>
                                            <TextBlock Grid.Column="1" Text="–" FontSize="16" Foreground="#FF9B5473" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource FormTextBox}" Text="{Binding ActivityRule.IntervalMaxMinutes}"
                                                     PreviewTextInput="NumericTextBoxPreviewTextInput" DataObject.Pasting="NumericTextBoxPasting"/>
                                        </Grid>
                                        <TextBlock Margin="1,5,0,0" Style="{StaticResource FormHint}" FontSize="11"
                                                   Text="范围 1–1440 分钟（不超过24小时）"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Style="{StaticResource FormLabel}" ToolTip="达到目标有效工作后建议离开屏幕的时长" Text="建议活动时长（分钟）"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ActivityRule.ActivityDurationMinutes}"
                                                 PreviewTextInput="NumericTextBoxPreviewTextInput" DataObject.Pasting="NumericTextBoxPasting"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,20,0,0" Style="{StaticResource FormCheckBox}" Content="启用免打扰时段（期间不提醒）" IsChecked="{Binding ActivityRule.QuietEnabled, Mode=TwoWay}"/>
                                <Border Style="{StaticResource FormSubPanel}" IsEnabled="{Binding ActivityRule.QuietEnabled}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="免打扰开始"/>
                                            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ActivityRule.QuietStartLocal}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="免打扰结束"/>
                                            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ActivityRule.QuietEndLocal}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FormHint}"
                                           Text="活动提醒只累计白名单应用的有效前台工作秒数；锁屏、全屏、演示和空闲超过 5 分钟时暂停累计。"/>
                            </StackPanel>
                        </Border>

                        <!--  保存  -->
                        <StackPanel Orientation="Horizontal" Margin="2,2,0,0">
                            <Button Content="保存规则" Command="{Binding SaveRulesCommand}" Style="{StaticResource PrimaryButton}"/>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="620" Foreground="#FFB14D7C" Text="{Binding RulesStatus}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Margin="2,14,0,16" Style="{StaticResource FormHint}"
                                   Text="时间格式为 HH:mm（如 08:00）；间隔为范围时，每轮提醒会在范围内随机取值，避免提醒过于机械。保存后最多 30 秒内生效，无需重启。"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="DiagnosticsPanel" Margin="30,26,30,20" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="28" FontWeight="SemiBold" Foreground="#FF263247" Text="状态诊断"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#FF9AA6B8" Text="{Binding DiagnosticsGeneratedAtText}"/>
                                <Button Content="立即刷新" Command="{Binding RefreshDiagnosticsCommand}" Style="{StaticResource GhostButton}" Margin="0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,8,0,20" Style="{StaticResource FormHint}"
                                   Text="回答“为什么没有计时或提醒”：先看有效工作计时是否满足条件，再看规则是否停用、是否在生效时段或免打扰时段、是否处于搁置状态。"/>

                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Style="{StaticResource FormAccentBar}"/>
                                    <TextBlock Grid.Column="1" Margin="11,0,0,0" Style="{StaticResource FormSectionTitle}" Text="提醒呈现"/>
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="提醒渠道"/>
                                        <TextBlock Foreground="{StaticResource InkBrush}" Text="{Binding DiagnosticsChannelText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,32,0">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="托盘暂停"/>
                                        <TextBlock Foreground="{StaticResource InkBrush}" Text="{Binding DiagnosticsPauseText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="呈现状态"/>
                                        <TextBlock Foreground="{StaticResource InkBrush}" Text="{Binding DiagnosticsSuppressionText}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FormHint}"
                                           Text="托盘菜单的“暂停提醒”和全屏、演示、锁屏都会让提醒延后显示，这是设计行为，不是故障。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Style="{StaticResource FormAccentBar}"/>
                                    <TextBlock Grid.Column="1" Margin="11,0,0,0" Style="{StaticResource FormSectionTitle}" Text="有效工作计时"/>
                                    <Border Grid.Column="2" Style="{StaticResource FormTagPill}" HorizontalAlignment="Left">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF9B5473" Text="{Binding WorkTrackingSummaryText}"/>
                                    </Border>
                                </Grid>
                                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding WorkTrackingReasons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <Ellipse Width="5" Height="5" Fill="#FFD98AB6" VerticalAlignment="Center"/>
                                                <TextBlock Margin="9,0,0,0" Foreground="{StaticResource InkSecondaryBrush}" Text="{Binding}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Style="{StaticResource FormAccentBar}"/>
                                    <TextBlock Grid.Column="1" Margin="11,0,0,0" Style="{StaticResource FormSectionTitle}" Text="提醒规则状态"/>
                                </Grid>
                                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding RuleDiagnosticItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="16,14" CornerRadius="13" Background="#FFFDF9FB" BorderBrush="#FFF6DFEA" BorderThickness="1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#FF9B5473" Text="{Binding KindText}"/>
                                                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" Text="{Binding StateText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource InkBrush}" Text="{Binding NextEstimateText}" TextWrapping="Wrap"/>
                                                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Reasons}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                    <Ellipse Width="4" Height="4" Fill="#FFD98AB6" VerticalAlignment="Center"/>
                                                                    <TextBlock Margin="9,0,0,0" Foreground="{StaticResource InkSecondaryBrush}" Text="{Binding}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="2,0,0,14" Foreground="#FFB14D7C" Text="{Binding DiagnosticsStatus}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="PetPanel" Margin="30,26,30,20" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FormPageTitle}" Text="桌宠与皮肤"/>
                        <TextBlock Margin="0,8,0,20" Style="{StaticResource FormHint}"
                                   Text="关闭桌宠后提醒会自动改走 Windows 通知；透明 PNG 始终按原始比例缩放。"/>
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Style="{StaticResource FormAccentBar}"/>
                                    <TextBlock Grid.Column="1" Margin="11,0,0,0" Style="{StaticResource FormSectionTitle}" Text="当前皮肤"/>
                                    <Border Grid.Column="2" Style="{StaticResource FormTagPill}" HorizontalAlignment="Left">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF9B5473" Text="{Binding CurrentSkinText}"/>
                                    </Border>
                                </Grid>
                                <CheckBox Margin="0,18,0,0" Style="{StaticResource FormCheckBox}" Content="显示透明可拖动桌宠" IsChecked="{Binding PetEnabled, Mode=TwoWay}"/>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FormHint}"
                                           Text="皮肤加载失败时会自动回退到占位皮肤，不会影响提醒；皮肤包放在数据目录的 skins 文件夹下即可。"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,18,0,0" Style="{StaticResource FormCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Style="{StaticResource FormAccentBar}"/>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Style="{StaticResource FormSectionTitle}" Text="气泡样式"/>
                                        <TextBlock Margin="0,5,0,0" Style="{StaticResource FormHint}"
                                                   Text="点击卡片即可立即切换桌宠气泡；文字区域会随主题自动避让装饰。"/>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer Margin="0,16,0,0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding BubbleThemes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BubbleThemeCardButton}"
                                                        Command="{Binding DataContext.SelectBubbleThemeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding Id}">
                                                    <StackPanel>
                                                        <Border Height="112" Background="#FFEFF7FC" CornerRadius="11" ClipToBounds="True">
                                                            <pet:BubbleThemePreview Theme="{Binding Theme}"
                                                                                    ResourcePath="{Binding PreviewPath}"
                                                                                    PreviewText="该休息一下啦"
                                                                                    Stretch="Uniform"
                                                                                    Margin="8"/>
                                                        </Border>
                                                        <Grid Margin="2,11,2,0">
                                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#FF263247" Text="{Binding Name}"/>
                                                            <Border x:Name="DefaultBadge" HorizontalAlignment="Right"
                                                                    Background="#FFE8F4FC" CornerRadius="9" Padding="8,3" Visibility="Collapsed">
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF4D7896" Text="默认"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Margin="2,7,2,1" Foreground="#FF718096" FontSize="12"
                                                                   Text="{Binding Description}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter TargetName="DefaultBadge" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource FormHint}" Text="{Binding BubbleThemeStatus}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <views:SettingsView x:Name="SettingsPanel" Margin="30,26,30,20" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
