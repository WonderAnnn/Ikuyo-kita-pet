<Window x:Class="IkuyoPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IkuyoPet.App.Views"
        Title="Ikuyo Pet"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF4F8FD">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFEAF4FF" Padding="18">
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#FF263247" Text="Ikuyo Pet" Margin="0,8,0,26"/>
                <Button Tag="Today" Click="NavigateClick" Content="今日" Style="{StaticResource NavButton}"/>
                <Button Tag="Log" Click="NavigateClick" Content="日志" Style="{StaticResource NavButton}"/>
                <Button Tag="Rules" Click="NavigateClick" Content="提醒规则" Style="{StaticResource NavButton}"/>
                <Button Tag="Pet" Click="NavigateClick" Content="桌宠与皮肤" Style="{StaticResource NavButton}"/>
                <Button Tag="Settings" Click="NavigateClick" Content="设置" Style="{StaticResource NavButton}"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="0">
            <views:TodayView x:Name="TodayPanel" Margin="28"/>
            <views:LogView x:Name="LogPanel" Margin="28" Visibility="Collapsed"/>
            <Grid x:Name="RulesPanel" Margin="28" Visibility="Collapsed"><StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#FF263247" Text="提醒规则"/><TextBlock Margin="0,10,0,0" Foreground="#FF68778D" Text="规则编辑将在提醒设置任务中接入。"/></StackPanel></Grid>
            <Grid x:Name="PetPanel" Margin="28" Visibility="Collapsed"><StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#FF263247" Text="桌宠与皮肤"/><TextBlock Margin="0,10,0,0" Foreground="#FF68778D" Text="透明桌宠和本地皮肤替换保持独立运行。"/></StackPanel></Grid>
            <views:SettingsView x:Name="SettingsPanel" Margin="28" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
